    },
    "condition": {
      "type": "origins:resource",
      "resource": "jorigins:myc/moveb_resource",
      "comparison": "==",
      "compare_to": 1
    }
  },
  "forward": {
    "type": "origins:active_self",
    "entity_action": {
      "type": "origins:if_else",
      "condition": {
        "type": "origins:on_block"
      },
      "if_action": {
        "type": "origins:add_velocity",
        "z": 0.1,
        "space": "local_horizontal_normalized"
      },
      "else_action": {
        "type": "origins:add_velocity",
        "z": 0.05,
        "space": "local_horizontal_normalized"
      }
    },
    "cooldown": 1,
    "hud_render": {
      "should_render": false
    },
    "key": {
      "key": "key.forward",
      "continuous": true
    },
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:resource",
          "resource": "jorigins:myc/moveb_resource",
          "comparison": "==",
          "compare_to": 1
        },
        {
          "type": "origins:or",
          "conditions": [
            {
              "type": "origins:resource",
              "resource": "jorigins:myc/tendril_blockabove",
              "comparison": "==",
              "compare_to": 1
            },
            {
              "type": "origins:resource",
              "resource": "jorigins:myc/tendril_floorahead",
              "comparison": "==",
              "compare_to": 1
            }
          ]
        }
      ]
    }
  },

