{
  "name": "Movement",
  "description": "Cave movement buff, test 1",
  "type": "origins:multiple",
  "switch": {
    "type": "origins:active_self",
    "entity_action": {
      "type": "origins:if_else",
      "condition": {
        "type": "origins:resource",
        "resource": "jorigins:myc/moveb_resource",
        "comparison": "==",
        "compare_to": 0
      },
      "if_action": {
        "type": "origins:change_resource",
        "resource": "jorigins:myc/moveb_resource",
        "change": 1,
        "operation": "set"
      },
      "else_action": {
        "type": "origins:change_resource",
        "resource": "jorigins:myc/moveb_resource",
        "change": 0,
        "operation": "set"
      }
    },
    "cooldown": 10,
    "hud_render": {
      "should_render": false
    },
    "key": {
      "key": "key.origins.primary_active"
    }
  },
  "resource": {
    "type": "origins:resource",
    "min": 0,
    "max": 1,
    "hud_render": [
      {
        "should_render": false
      }
    ],
    "min_action": {
      "type": "origins:execute_command",
      "command": "function jorigins:myc/reset",
      "permission_level": 4
    },
    "max_action": {
      "type": "origins:execute_command",
      "command": "function jorigins:myc/setup",
      "permission_level": 4
    }
  },
  "nosprint": {
    "type": "origins:prevent_sprinting",
    "condition": {
      "type": "origins:resource",
      "resource": "jorigins:myc/moveb_resource",
      "comparison": "==",
      "compare_to": 1
    }
  },
  "nofall": {
    "type": "origins:modify_falling",
    "velocity": 0,
    "take_fall_damage": false,
    "condition": {
      "type": "origins:resource",
      "resource": "jorigins:myc/moveb_resource",
      "comparison": "==",
      "compare_to": 1
    }
  },
  "nojump": {
    "type": "origins:modify_jump",
    "modifier": {
      "id": "jorigins:nojump",
      "operation": "set_total",
      "amount": 0
    },
    "condition": {
      "type": "origins:resource",
      "resource": "jorigins:myc/moveb_resource",
      "comparison": "==",
      "compare_to": 1
    }
  },
  "noairspeed": {
    "type": "origins:modify_air_speed",
    "modifier": {
      "id": "jorigins:noair",
      "operation": "set_total",
