    },
    "key": {
      "key": "key.sneak",
      "continuous": true
    },
    "condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:resource",
          "resource": "jorigins:myc/moveb_resource",
          "comparison": "==",
          "compare_to": 1
        },
        {
          "type": "origins:or",
          "conditions": [
